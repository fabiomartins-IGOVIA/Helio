# Modelo de variáveis de ambiente.
# Copie este arquivo para um novo, chamado .env, e preencha os valores.
# O arquivo .env NUNCA é enviado ao GitHub (veja o .gitignore).
#
# Chave pública vigente do Datajud — copie sempre da wiki oficial:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Backend Django
DJANGO_SECRET_KEY=troque-esta-chave-em-ambientes-reais
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco local padrão: SQLite.
# Para PostgreSQL, use DB_ENGINE=postgresql e preencha as variáveis abaixo.
DB_ENGINE=sqlite
DB_NAME=data/helio.sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
