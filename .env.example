# Modelo de variáveis de ambiente.
# Copie este arquivo para um novo, chamado .env, e preencha os valores.
# O arquivo .env NUNCA é enviado ao GitHub (veja o .gitignore).
#
# Chave pública vigente do Datajud — copie sempre da wiki oficial:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Backend Django
DJANGO_SECRET_KEY=troque-esta-chave-em-ambientes-reais
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco local padrão: SQLite.
# Para usar o banco real do Hélio, abra primeiro o túnel SSH e altere DB_ENGINE
# para postgresql. Nunca coloque a senha real neste arquivo ou no Git.
DB_ENGINE=sqlite
DB_NAME=data/helio.sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# Configuração quando o túnel SSH estiver ativo:
# ssh -N -L 5433:127.0.0.1:5432 tunel_seu_usuario@server.igovia.com.br
# DB_ENGINE=postgresql
# DB_NAME=helio
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
